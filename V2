<!DOCTYPE html>
<html lang="de">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, user-scalable=no">
  <title>SPACE BITCOIN - Endboss Edition</title>
  <style>
    @import url('https://fonts.googleapis.com/css2?family=Orbitron:wght@500;700;900&family=Rajdhani:wght@500;600;700&display=swap');

    * { box-sizing: border-box; }

    body {
      margin: 0;
      padding: 0;
      background: #040309;
      overflow: hidden;
      font-family: 'Rajdhani', 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
      color: #fff;
      user-select: none;
      touch-action: none;
    }

    body::before {
      content: '';
      position: fixed;
      inset: 0;
      pointer-events: none;
      z-index: 5;
      background:
        repeating-linear-gradient(0deg, rgba(255,255,255,0.015) 0px, rgba(255,255,255,0.015) 1px, transparent 1px, transparent 3px),
        radial-gradient(circle at 50% 0%, rgba(247,147,26,0.07), transparent 55%);
      mix-blend-mode: overlay;
    }

    canvas {
      display: block;
      background: radial-gradient(circle at 50% 25%, #121a3d 0%, #070a1a 55%, #020208 100%);
      cursor: crosshair;
    }

    #ui {
      position: absolute;
      top: 15px;
      left: 20px;
      right: 20px;
      display: flex;
      justify-content: space-between;
      align-items: center;
      pointer-events: none;
      font-size: 14px;
      font-weight: 700;
      letter-spacing: 0.5px;
      z-index: 10;
      flex-wrap: wrap;
      gap: 10px;
      font-family: 'Orbitron', sans-serif;
    }

    .hud-group {
      background: linear-gradient(135deg, rgba(16, 20, 40, 0.85), rgba(8, 10, 24, 0.85));
      backdrop-filter: blur(10px);
      padding: 9px 18px;
      border: 1px solid rgba(247, 147, 26, 0.45);
      border-radius: 14px;
      box-shadow: 0 4px 18px rgba(0, 0, 0, 0.55), inset 0 0 12px rgba(247, 147, 26, 0.12);
      text-shadow: 0 0 10px rgba(247, 147, 26, 0.7);
    }

    /* Boss Health Bar HUD */
    #boss-hp-container {
      position: absolute;
      top: 75px;
      left: 50%;
      transform: translateX(-50%);
      width: 60%;
      max-width: 600px;
      background: linear-gradient(135deg, rgba(18, 10, 28, 0.9), rgba(8, 6, 18, 0.9));
      border: 2px solid #8c6bff;
      border-radius: 14px;
      padding: 6px;
      box-shadow: 0 0 30px rgba(140, 110, 255, 0.55), inset 0 0 15px rgba(140, 110, 255, 0.15);
      display: none;
      z-index: 20;
      text-align: center;
      animation: bossPulse 1.6s ease-in-out infinite;
    }

    @keyframes bossPulse {
      0%, 100% { box-shadow: 0 0 30px rgba(140, 110, 255, 0.55), inset 0 0 15px rgba(140, 110, 255, 0.15); }
      50% { box-shadow: 0 0 48px rgba(231, 76, 60, 0.65), inset 0 0 18px rgba(231, 76, 60, 0.2); }
    }

    #boss-hp-title {
      font-family: 'Orbitron', sans-serif;
      font-size: 12px;
      font-weight: 900;
      color: #c7b9ff;
      letter-spacing: 2.5px;
      margin-bottom: 4px;
      text-transform: uppercase;
      text-shadow: 0 0 10px rgba(140,110,255,0.8);
    }

    #boss-hp-bar-bg {
      width: 100%;
      height: 18px;
      background: #15132a;
      border-radius: 8px;
      overflow: hidden;
      box-shadow: inset 0 0 6px rgba(0,0,0,0.8);
    }

    #boss-hp-bar-fill {
      width: 100%;
      height: 100%;
      background: linear-gradient(90deg, #e74c3c, #8e44ad, #627eea, #8c6bff);
      background-size: 200% 100%;
      box-shadow: 0 0 14px #8c6bff;
      transition: width 0.1s linear;
      animation: shimmer 2.5s linear infinite;
    }

    @keyframes shimmer {
      0% { background-position: 0% 0; }
      100% { background-position: 200% 0; }
    }

    #startgame, #gameover, #win-screen {
      position: absolute;
      top: 0; left: 0; width: 100%; height: 100%;
      background:
        radial-gradient(circle at 50% 20%, rgba(247,147,26,0.12), transparent 60%),
        rgba(3, 4, 12, 0.94);
      backdrop-filter: blur(14px);
      display: flex;
      flex-direction: column;
      justify-content: center;
      align-items: center;
      z-index: 100;
      text-align: center;
      padding: 20px;
      box-sizing: border-box;
      animation: fadeIn 0.5s ease;
    }

    @keyframes fadeIn {
      from { opacity: 0; }
      to { opacity: 1; }
    }

    .author-tag {
      color: #00ffcc;
      font-family: 'Orbitron', sans-serif;
      font-size: 1.1rem;
      letter-spacing: 4px;
      text-transform: uppercase;
      font-weight: 800;
      margin-bottom: 8px;
      text-shadow: 0 0 15px rgba(0, 255, 204, 0.8), 0 0 30px rgba(0, 255, 204, 0.4);
    }

    h1 {
      font-family: 'Orbitron', sans-serif;
      font-size: 3.6rem;
      font-weight: 900;
      margin-top: 0;
      margin-bottom: 12px;
      background: linear-gradient(135deg, #F7931A 0%, #ffd166 50%, #F7931A 100%);
      -webkit-background-clip: text;
      background-clip: text;
      color: transparent;
      text-shadow: 0 0 40px rgba(247, 147, 26, 0.5);
      letter-spacing: 2px;
    }

    p {
      color: #b7bedb;
      font-size: 1.15rem;
      max-width: 620px;
      line-height: 1.6;
      margin-bottom: 32px;
    }

    .btn {
      position: relative;
      overflow: hidden;
      background: linear-gradient(135deg, #F7931A 0%, #ffab3b 100%);
      color: #05050a;
      border: none;
      padding: 17px 46px;
      font-family: 'Orbitron', sans-serif;
      font-size: 1.2rem;
      font-weight: 800;
      border-radius: 32px;
      cursor: pointer;
      transition: all 0.25s cubic-bezier(0.175, 0.885, 0.32, 1.275);
      box-shadow: 0 0 25px rgba(247, 147, 26, 0.5);
      text-transform: uppercase;
      letter-spacing: 1.5px;
    }

    .btn::after {
      content: '';
      position: absolute;
      top: 0; left: -75%;
      width: 50%; height: 100%;
      background: linear-gradient(120deg, transparent, rgba(255,255,255,0.55), transparent);
      transform: skewX(-20deg);
      transition: left 0.6s ease;
    }

    .btn:hover::after { left: 125%; }

    .btn:hover {
      transform: scale(1.08) translateY(-2px);
      box-shadow: 0 0 45px rgba(247, 147, 26, 0.9);
      background: linear-gradient(135deg, #ffab3b 0%, #ffd166 100%);
    }

    #gameover, #win-screen {
      display: none;
    }

    #gameover h1 {
      background: linear-gradient(135deg, #ff5e5e, #ff8a3d);
      -webkit-background-clip: text;
      background-clip: text;
      color: transparent;
    }

    .win-title {
      color: #ffd166;
      font-size: 2.9rem;
      margin-bottom: 12px;
    }

    .win-text {
      font-size: 1.5rem;
      font-weight: 800;
      color: #00ffcc;
      text-shadow: 0 0 20px rgba(0,255,204,0.8);
      margin-bottom: 24px;
      font-family: 'Rajdhani', sans-serif;
    }

    /* Credits Roll Container */
    #credits-container {
      position: absolute;
      bottom: 0;
      left: 50%;
      transform: translateX(-50%);
      width: 80%;
      max-width: 800px;
      height: 100%;
      overflow: hidden;
      pointer-events: none;
      display: none;
      z-index: 90;
      mask-image: linear-gradient(to bottom, transparent 0%, black 15%, black 85%, transparent 100%);
      -webkit-mask-image: linear-gradient(to bottom, transparent 0%, black 15%, black 85%, transparent 100%);
    }

    #credits-content {
      position: absolute;
      width: 100%;
      top: 100%;
      text-align: center;
      color: #f1c40f;
      font-family: 'Courier New', Courier, monospace;
      line-height: 1.8;
      font-size: 1.1rem;
      text-shadow: 0 0 10px rgba(241, 196, 15, 0.5);
    }

    #credits-content h2 {
      color: #00ffcc;
      margin-top: 40px;
      font-size: 1.8rem;
      font-family: 'Orbitron', sans-serif;
    }
  </style>
</head>
